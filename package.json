{
  "name": "widget-spotify",
  "version": "0.2.3",
  "description": "Mini-telecomando Spotify richiamabile dalla barra delle applicazioni di Windows",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "make-icon": "node scripts/make-icon.js",
    "make-social": "electron scripts/make-social.js",
    "dist": "npm run make-icon && electron-builder",
    "pack": "npm run make-icon && electron-builder --dir",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\""
  },
  "author": "giosci1994",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "com.giosci1994.widgetspotify",
    "productName": "Widget Spotify",
    "files": [
      "src/**/*",
      "assets/**/*",
      "config.example.json",
      "!config.json",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "giosci1994",
        "repo": "widget-spotify"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Widget Spotify",
      "artifactName": "WidgetSpotify-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WidgetSpotify-portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
